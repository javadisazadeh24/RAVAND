// RAVAND Management OS — PostgreSQL (local and remote use the same schema)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  MEMBER
  INTERN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  PROJECT_BASED
  CONTRACTOR
  INTERN
  TRAINEE
  VOLUNTEER
  PARTNER
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  BLOCKED
  COMPLETED
  CANCELLED
}

enum TaskType {
  ENGINEERING
  MANUFACTURING
  SALES
  MARKETING
  ADMINISTRATIVE
  RESEARCH
  FINANCIAL
  MANAGEMENT
  TRAINING
  FOLLOW_UP
}

enum ProjectStatus {
  PLANNING
  WAITING_APPROVAL
  ACTIVE
  WAITING_PAYMENT
  IN_PRODUCTION
  BLOCKED
  COMPLETED
  ARCHIVED
}

enum HealthStatus {
  HEALTHY
  AT_RISK
  BLOCKED
  OVERDUE
  COMPLETED
}

enum ReportType {
  DAILY
  WEEKLY
  PROJECT
}

enum ReportState {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum Currency {
  TOMAN
  RIAL
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          Role           @default(MEMBER)
  employment    EmploymentType @default(FULL_TIME)
  title         String?
  active        Boolean        @default(true)
  canSeeFinance Boolean        @default(false)
  createdAt     DateTime       @default(now())
  deletedAt     DateTime?

  skills          UserSkill[]
  assignedTasks   Task[]          @relation("assignee")
  createdTasks    Task[]          @relation("creator")
  managedProjects Project[]       @relation("pm")
  memberships     ProjectMember[]
  reports         Report[]        @relation("author")
  comments        Comment[]
  notifications   Notification[]
  reminders       Reminder[]
  audit           AuditLog[]
}

model Skill {
  id    String      @id @default(cuid())
  name  String      @unique
  users UserSkill[]
}

model UserSkill {
  userId  String
  skillId String
  level   Int    @default(1)
  user    User   @relation(fields: [userId], references: [id])
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

model Client {
  id        String    @id @default(cuid())
  name      String
  org       String?
  phone     String?
  notes     String?
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  projects  Project[]
}

model ProjectCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id             String        @id @default(cuid())
  code           String        @unique
  title          String
  description    String?
  clientId       String?
  categoryId     String?
  pmId           String?
  priority       Priority      @default(MEDIUM)
  status         ProjectStatus @default(PLANNING)
  startDate      DateTime?
  deadline       DateTime?
  currency       Currency      @default(TOMAN)
  estBudget      BigInt?
  estRevenue     BigInt?
  progressManual Int?
  healthOverride HealthStatus?
  healthReason   String?
  objectiveId    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  client   Client?          @relation(fields: [clientId], references: [id])
  category ProjectCategory? @relation(fields: [categoryId], references: [id])
  pm       User?            @relation("pm", fields: [pmId], references: [id])
  members  ProjectMember[]
  tasks    Task[]
  reports  Report[]

  @@index([status])
  @@index([deadline])
}

model ProjectMember {
  projectId String
  userId    String
  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@id([projectId, userId])
}

model Task {
  id                 String     @id @default(cuid())
  number             Int        @default(autoincrement())
  title              String
  description        String?
  projectId          String?
  parentId           String?
  assigneeId         String?
  creatorId          String
  type               TaskType   @default(ADMINISTRATIVE)
  priority           Priority   @default(MEDIUM)
  status             TaskStatus @default(NOT_STARTED)
  startDate          DateTime?
  deadline           DateTime?
  estHours           Float?
  actualHours        Float?
  progress           Int        @default(0)
  blockerNote        String?
  labels             String[]
  checklist          Json?
  recurrence         Json?
  recurrenceSourceId String?
  completedAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  project   Project?         @relation(fields: [projectId], references: [id])
  parent    Task?            @relation("sub", fields: [parentId], references: [id])
  subtasks  Task[]           @relation("sub")
  assignee  User?            @relation("assignee", fields: [assigneeId], references: [id])
  creator   User             @relation("creator", fields: [creatorId], references: [id])
  dependsOn TaskDependency[] @relation("dependent")
  blocks    TaskDependency[] @relation("dependency")
  comments  Comment[]
  reminders Reminder[]

  @@index([assigneeId, status])
  @@index([deadline])
  @@index([projectId])
}

model TaskDependency {
  taskId      String
  dependsOnId String
  task        Task   @relation("dependent", fields: [taskId], references: [id])
  dependsOn   Task   @relation("dependency", fields: [dependsOnId], references: [id])

  @@id([taskId, dependsOnId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  authorId  String
  taskId    String?
  reportId  String?
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  task      Task?    @relation(fields: [taskId], references: [id])
  report    Report?  @relation(fields: [reportId], references: [id])
}

model Report {
  id               String      @id @default(cuid())
  type             ReportType
  state            ReportState @default(DRAFT)
  authorId         String
  projectId        String?
  periodStart      DateTime
  periodEnd        DateTime
  content          Json
  reportedProgress Int?
  verifiedProgress Int?
  reviewerId       String?
  reviewNote       String?
  submittedAt      DateTime?
  createdAt        DateTime    @default(now())

  author    User             @relation("author", fields: [authorId], references: [id])
  project   Project?         @relation(fields: [projectId], references: [id])
  revisions ReportRevision[]
  comments  Comment[]

  @@index([authorId, type, periodStart])
}

model ReportRevision {
  id       String   @id @default(cuid())
  reportId String
  content  Json
  savedAt  DateTime @default(now())
  report   Report   @relation(fields: [reportId], references: [id])
}

model Attachment {
  id           String   @id @default(cuid())
  filename     String
  path         String
  mime         String
  size         Int
  ownerType    String
  ownerId      String
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([ownerType, ownerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
}

model Reminder {
  id         String    @id @default(cuid())
  userId     String
  title      String
  remindAt   DateTime
  taskId     String?
  notifiedAt DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id])
  task       Task?     @relation(fields: [taskId], references: [id])

  @@index([userId, remindAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
}

model Setting {
  key   String @id
  value Json
}
